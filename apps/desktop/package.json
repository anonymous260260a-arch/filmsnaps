{
  "name": "@filmsnaps/desktop",
  "version": "1.0.3",
  "author": "FilmSnaps",
  "private": true,
  "description": "FilmSnaps Desktop App — secure streaming with Electron",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"cd ../web && pnpm dev\" \"wait-on http://localhost:3000 && pnpm build && pnpm exec electron . --dev\"",
    "build": "tsc && node scripts/inject-preload-css.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm build && electron-builder --publish=never",
    "dist:publish": "pnpm build && electron-builder --publish=always",
    "pack": "pnpm build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist release"
  },
  "build": {
    "appId": "app.filmsnaps.desktop",
    "productName": "FilmSnaps",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../../packages/filter-compiler/build/compiled-engine.bin",
        "to": "filter-engine/compiled-engine.bin"
      },
      {
        "from": "../../blocklist.json",
        "to": "blocklist.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  },
  "dependencies": {
    "@cliqz/adblocker": "^1.34.0",
    "@filmsnaps/adblock-config": "workspace:*",
    "@filmsnaps/filter-compiler": "workspace:*",
    "@filmsnaps/shared": "workspace:*",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.0"
  }
}
