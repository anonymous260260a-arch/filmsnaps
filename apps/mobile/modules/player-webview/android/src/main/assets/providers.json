  "rules": {
    "videoDetection": {
      "extensions": [
        "m3u8",
        "mpd",
        "ts",
        "m4s",
        "mp4",
        "webm",
        "mkv",
        "m4v",
        "3gp",
        "cmfv",
        "cmfa",
        "aac",
        "key"
      ],
      "pathPatterns": [
        "^/(embed|movie|tv|watch|player|tou)/\\d+/.*(\\.(m3u8|mpd|mp4))",
        "^/[a-zA-Z0-9_-]{20,}/(master|index|playlist|manifest)\\.(m3u8|mpd)"
      ],
      "enableSessionTrust": true,
      "trustTTLMs": 900000
    },
