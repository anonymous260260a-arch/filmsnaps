        "/banner\\.",
        "\\.wasm"
      ]
    }
  },
  "navigationGuard": {
    "universalBlockPaths": ["/"],
    "shallowDepthThreshold": 1
  },
  "providers": [
    {
      "id": "nxsha",
      "embedDomains": ["web.nxsha.app"],
      "cdnDomains": [
        "nxcdn.app",
        "cdn.nxsha.app",
        "proxy.itsnitrox.tech",
        "oo.itsnitrox.tech"
      ],
      "enabled": true,
      "cosmeticRules": [
        "button:has(svg.lucide-list){display:none!important}",
        "button[title=\"Crop to Fill\"]{display:none!important}",
        "div[class*=\"right-3\"][class*=\"top-1/2\"][class*=\"z-30\"]{display:none!important}"
      ]
    },
    {
      "id": "peachify",
      "embedDomains": ["peachify.top"],
      "cdnDomains": ["eat-peach.sbs", "peachify.top"],
      "enabled": true,
      "docStartBundle": false,
      "reactSafe": true
    },
    {
      "id": "screenscape",
      "embedDomains": ["screenscape.me"],
      "cdnDomains": [],
      "enabled": true,
      "blockHomePaths": ["/", "/home", "/trending"],
      "apiIntercepts": [
        {
          "match": "/api/ads/cycles",
          "methods": ["GET", "POST"],
          "synthetic": {
            "primary": {
              "ok": true,
              "anchorMs": "@@NOW@@"
            },
            "fallback": {
              "anchorMs": "@@NOW@@",
              "source": "fallback"
            },
            "fallbackCondition": "source=fallback"
          }
        }
      ],
      "cosmeticRules": [
        "button[aria-label^=\"Ads window ends\"]{display:none!important}",
        "button[title^=\"Ads window ends\"]{display:none!important}",
        "div[aria-label^=\"Ads window ends\"]{display:none!important}",
        "span[aria-label^=\"Ads window ends\"]{display:none!important}",
        "div:has(> a[href=\"https://screenscape.fun\"]){display:none!important}",
        "a[href=\"https://screenscape.fun\"]{display:none!important}",
        "a[href=\"https://screenscape.fun\"] + *{display:none!important}",
        "button[title^=\"Download Sources\"]{display:none!important}",
        "button[title^=\"Switch server and open Telegram\"]{display:none!important}",
        "div:has(> button[aria-label=\"Dismiss\"]){display:none!important}"
      ]
    },
    {
