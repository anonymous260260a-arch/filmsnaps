TMDB_API_KEY=

# Remote blocklist config URL (optional, overrides GitHub default)
# Set this to host your own blocklist.json on a CDN
# BLOCKLIST_CONFIG_URL=https://my-cdn.com/blocklist.json

# Phase 4 telemetry (web worker /api/telemetry)
# Set to 0 to kill-switch (204 + drop, no D1 insert)
TELEMETRY_ENABLED=1
# Static x-telemetry-token header the mobile app sends (empty = no check)
TELEMETRY_INGEST_TOKEN=
# /admin HTTP Basic Auth password (user can be anything). Unset = /admin 401.
ADMIN_TOKEN=

NEXT_PUBLIC_SITE_URL=


