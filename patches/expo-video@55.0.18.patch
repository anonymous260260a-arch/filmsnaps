+package expo.modules.video.utils;
+
+import android.net.Uri;
+import androidx.media3.common.util.UnstableApi;
+import androidx.media3.extractor.DefaultExtractorsFactory;
+import androidx.media3.extractor.Extractor;
+import androidx.media3.extractor.ExtractorsFactory;
+import androidx.media3.extractor.text.DefaultSubtitleParserFactory;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Custom {@link ExtractorsFactory} that registers {@link SecondarySeekHeadMatroskaExtractor}
+ * as the first MKV extractor, falling back to {@link DefaultExtractorsFactory} for all
+ * other formats.
+ *
+ * <p>The secondary SeekHead extractor resolves Cues positions stored behind a secondary
+ * SeekHead pointer (Primary SeekHead → secondary SeekHead → Cues), which the stock
+ * {@code MatroskaExtractor} does not handle.
+ *
+ * <p>Non-MKV formats (MP4, HLS, DASH, etc.) are unaffected.
+ */
+@UnstableApi
+public final class CustomExtractorsFactory implements ExtractorsFactory {
+
+  // BEGIN player-tuning (expo-video patch)
+  /**
+   * JS-tunable MKV extractor selection ("vendored" | "stock"). "vendored"
+   * (default) puts SecondarySeekHeadMatroskaExtractor first so MKVs whose
+   * Cues live behind a secondary SeekHead resolve. "stock" skips it — the
+   * kill switch if the vendored extractor ever regresses on some file after
+   * release (stock MatroskaExtractor still plays MKV, just without secondary
+   * SeekHead resolution). Read on every createExtractors() call, so a flip
+   * takes effect at the next prepare.
+   */
+  public static volatile String mkvExtractorMode = "vendored";
+  // END player-tuning (expo-video patch)
+
+  private final DefaultExtractorsFactory defaultFactory = new DefaultExtractorsFactory();
+
+  @Override
+  public synchronized Extractor[] createExtractors() {
+    return createExtractors(Uri.EMPTY, java.util.Collections.emptyMap());
+  }
+
+  @Override
+  public synchronized Extractor[] createExtractors(
+      Uri uri, Map<String, List<String>> responseHeaders) {
+    // Our custom MKV extractor first, then everything from the default factory.
+    // The SecondarySeekHeadMatroskaExtractor will sniff MKV and handle secondary
+    // SeekHead resolution.  For non-MKV files, it will not match and the default
+    // extractors will be used.
+    Extractor[] defaultExtractors = defaultFactory.createExtractors(uri, responseHeaders);
+    // BEGIN player-tuning (expo-video patch) — kill switch, see mkvExtractorMode.
+    if ("stock".equalsIgnoreCase(mkvExtractorMode)) {
+      return defaultExtractors;
+    }
+    // END player-tuning (expo-video patch)
+    Extractor[] result = new Extractor[defaultExtractors.length + 1];
+    // DefaultSubtitleParserFactory matches what stock Media3 1.8.0's
+    // DefaultExtractorsFactory passes to MatroskaExtractor: subtitle tracks are
+    // parsed during extraction. The deprecated no-arg constructor used
+    // Factory.UNSUPPORTED + raw emission, which breaks/throws on subtitle
+    // selection for some MKV text tracks.
+    result[0] = new SecondarySeekHeadMatroskaExtractor(new DefaultSubtitleParserFactory());
+    System.arraycopy(defaultExtractors, 0, result, 1, defaultExtractors.length);
+    return result;
+  }
+}
