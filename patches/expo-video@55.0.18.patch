+  // =====================================================================================
+  // Secondary SeekHead pre-pass (expo-video patch).
+  //
+  // Some muxers place the only Cues reference inside a secondary SeekHead that the stock
+  // sequential parse never traverses. This pre-pass resolves the Cues position (peek-only
+  // scan of the file head, plus at most a few ranged fetches via Extractor.RESULT_SEEK),
+  // then hands control to the stock logic unchanged - including the stock seek-for-Cues
+  // machinery, exactly as for files whose primary SeekHead references Cues directly.
+  //
+  // ExtractorInput cannot seek backwards, so no method here consumes the input in phase 1
+  // (peek-only) and every phase that must read elsewhere returns RESULT_SEEK, letting the
+  // framework reopen the data source at the requested offset.
+  // =====================================================================================
+
+  private static final String SSH_TAG = "SecondarySeekHeadMKV";
+
+  /** Pre-pass phases. */
+  private static final int SSH_PHASE_SCAN_PRIMARY = 0;
+  private static final int SSH_PHASE_PARSE_SECONDARY = 1;
+  private static final int SSH_PHASE_DONE = 2;
+
+  /** Safety limits for the metadata-region scan. */
+  private static final int SSH_MAX_SCAN_ELEMENTS = 64;
+  private static final int SSH_MAX_SCAN_BYTES = 1024 * 1024;
+  private static final int SSH_MAX_SEEK_ATTEMPTS = 3;
+  private static final int SSH_MAX_CHAIN_HOPS = 3;
+
+  private int sshPhase = SSH_PHASE_SCAN_PRIMARY;
+  private int sshSeekToStartAttempts;
+  private int sshSecondarySeekAttempts;
+  private int sshChainHops;
+  private long sshSegmentContentPosition = C.INDEX_UNSET;
+  private long sshSecondarySeekHeadPosition = C.INDEX_UNSET;
+  private final byte[] sshScratch = new byte[16];
+
+  // BEGIN pre-pass timing (expo-video patch) — per-hop elapsed for the 2A
+  // gain decision (docs/native-player-upgrades.md).
+  private long sshPrePassStartedMs;
+  // END pre-pass timing (expo-video patch)
+
+  // BEGIN subtitle-offset (expo-video patch)
+  /**
+   * Subtitle sync offset in milliseconds, set from JS via VideoModule.
+   * Applied to text-track block timestamps only. Static on purpose: it must
+   * survive extractor recreation on every source switch and cover all
+   * subsequent plays of the session.
+   */
+  public static volatile double subtitleOffsetMs = 0d;
+  // END subtitle-offset (expo-video patch)
+
+  // BEGIN pre-pass timing (expo-video patch)
+  private long sshElapsedMs() {
+    return sshPrePassStartedMs == 0L
+        ? 0L
+        : android.os.SystemClock.elapsedRealtime() - sshPrePassStartedMs;
+  }
+  // END pre-pass timing (expo-video patch)
+
+  /** Entry point for the pre-pass; called from read() until the phase is DONE. */
+  private int sshResolveCues(ExtractorInput input, PositionHolder seekPosition)
+      throws IOException {
+    long inputLength = input.getLength();
+    // BEGIN pre-pass timing (expo-video patch)
+    if (sshPrePassStartedMs == 0L) {
+      sshPrePassStartedMs = android.os.SystemClock.elapsedRealtime();
+    }
+    // END pre-pass timing (expo-video patch)
+    switch (sshPhase) {
+      case SSH_PHASE_SCAN_PRIMARY:
+        return sshScanPrimary(input, inputLength, seekPosition);
+      case SSH_PHASE_PARSE_SECONDARY:
+      default:
+        return sshParseSecondary(input, inputLength, seekPosition);
+    }
+  }
+
+  private int sshScanPrimary(ExtractorInput input, long inputLength,
+      PositionHolder seekPosition) throws IOException {
+    if (input.getPosition() != 0) {
+      if (sshSeekToStartAttempts++ < SSH_MAX_SEEK_ATTEMPTS) {
+        Log.w(SSH_TAG, "scan: input not at file start (position="
+            + input.getPosition() + "); requesting seek to 0 (attempt "
+            + sshSeekToStartAttempts + ")");
+        seekPosition.position = 0;
+        return Extractor.RESULT_SEEK;
+      }
+      Log.w(SSH_TAG, "scan: cannot restart at file start; giving up on pre-pass");
+      sshPhase = SSH_PHASE_DONE;
+      return Extractor.RESULT_CONTINUE;
+    }
+    input.resetPeekPosition();
+    Log.i(SSH_TAG, "scan: scanning file head for SeekHead entries (length="
+        + inputLength + ")");
+    SshScanResult scan = sshScanFileHead(input, inputLength);
+    input.resetPeekPosition();
+    sshSegmentContentPosition = scan.segmentContentPosition;
+
+    if (scan.directCuesPosition != C.INDEX_UNSET) {
+      cuesContentPosition = scan.directCuesPosition;
+      sshPhase = SSH_PHASE_DONE;
+      // BEGIN pre-pass timing (expo-video patch)
+      Log.i(SSH_TAG, "scan: primary SeekHead references Cues directly; "
+          + "cuesContentPosition=" + cuesContentPosition + " (no extra fetch needed, +"
+          + sshElapsedMs() + "ms)");
+      // END pre-pass timing (expo-video patch)
+      return Extractor.RESULT_CONTINUE;
+    }
+    if (scan.secondarySeekHeadPosition == C.INDEX_UNSET
+        || !sshIsPositionInRange(scan.secondarySeekHeadPosition, inputLength)
+        || scan.secondarySeekHeadPosition == scan.primarySeekHeadPosition) {
+      sshPhase = SSH_PHASE_DONE;
+      Log.i(SSH_TAG, "scan: no usable secondary SeekHead reference; continuing "
+          + "with stock behavior (file may be unseekable)");
+      return Extractor.RESULT_CONTINUE;
+    }
+    sshSecondarySeekHeadPosition = scan.secondarySeekHeadPosition;
+    sshSecondarySeekAttempts = 0;
+    sshChainHops = 0;
+    sshPhase = SSH_PHASE_PARSE_SECONDARY;
+    Log.i(SSH_TAG, "scan: primary SeekHead references secondary SeekHead at "
+        + sshSecondarySeekHeadPosition + " (segmentContentPosition="
+        + sshSegmentContentPosition + ", relative="
+        + (sshSecondarySeekHeadPosition - sshSegmentContentPosition)
+        // BEGIN pre-pass timing (expo-video patch)
+        + "); requesting ranged fetch (+" + sshElapsedMs() + "ms)");
+    // END pre-pass timing (expo-video patch)
+    seekPosition.position = sshSecondarySeekHeadPosition;
+    return Extractor.RESULT_SEEK;
+  }
+
+  private int sshParseSecondary(ExtractorInput input, long inputLength,
+      PositionHolder seekPosition) throws IOException {
+    long position = input.getPosition();
+    if (position != sshSecondarySeekHeadPosition) {
+      if (sshSecondarySeekAttempts++ < SSH_MAX_SEEK_ATTEMPTS) {
+        Log.w(SSH_TAG, "secondary: input at " + position + " but expected "
+            + sshSecondarySeekHeadPosition + "; re-requesting (attempt "
+            + sshSecondarySeekAttempts + ")");
+        seekPosition.position = sshSecondarySeekHeadPosition;
+        return Extractor.RESULT_SEEK;
+      }
+      Log.w(SSH_TAG, "secondary: could not position at the secondary SeekHead "
+          + "(server ignoring Range requests?); falling back to sequential parsing");
+      sshPhase = SSH_PHASE_DONE;
+      seekPosition.position = 0;
+      return Extractor.RESULT_SEEK;
+    }
+    input.resetPeekPosition();
+    // BEGIN pre-pass timing (expo-video patch)
+    Log.i(SSH_TAG, "secondary: reading SeekHead at position " + position
+        + " (+" + sshElapsedMs() + "ms)");
+    // END pre-pass timing (expo-video patch)
+    SshScanResult scan = new SshScanResult();
+    scan.segmentContentPosition = sshSegmentContentPosition;
+    boolean parsed = false;
+    SshElementHeader header = sshPeekElementHeader(input);
+    if (header != null && header.id == ID_SEEK_HEAD) {
+      parsed = sshParseSeekHead(input, header, scan, inputLength);
+    } else {
+      Log.w(SSH_TAG, "secondary: element at target position is not a SeekHead ("
+          + (header == null ? "end of input" : "id 0x" + Integer.toHexString(header.id)) + ")");
+    }
+    input.resetPeekPosition();
+
+    if (scan.directCuesPosition != C.INDEX_UNSET
+        && sshIsPositionInRange(scan.directCuesPosition, inputLength)) {
+      cuesContentPosition = scan.directCuesPosition;
+      Log.i(SSH_TAG, "secondary: resolved Cues via secondary SeekHead; "
+          + "cuesContentPosition=" + cuesContentPosition + " (relative="
+          + (cuesContentPosition - sshSegmentContentPosition) + "); pre-pass succeeded");
+    } else if (parsed
+        && scan.secondarySeekHeadPosition != C.INDEX_UNSET
+        && scan.secondarySeekHeadPosition != sshSecondarySeekHeadPosition
+        && sshIsPositionInRange(scan.secondarySeekHeadPosition, inputLength)
+        && sshChainHops++ < SSH_MAX_CHAIN_HOPS) {
+      sshSecondarySeekHeadPosition = scan.secondarySeekHeadPosition;
+      Log.i(SSH_TAG, "secondary: following SeekHead chain to "
+          + sshSecondarySeekHeadPosition);
+      seekPosition.position = sshSecondarySeekHeadPosition;
+      return Extractor.RESULT_SEEK;
+    } else {
+      Log.w(SSH_TAG, "secondary: no Cues reference found; pre-pass failed "
+          + "(stock behavior applies)");
+    }
+    sshPhase = SSH_PHASE_DONE;
+    // BEGIN pre-pass timing (expo-video patch)
+    Log.i(SSH_TAG, "pre-pass complete in " + sshElapsedMs()
+        + "ms; seeking back to 0 for the main parse");
+    // END pre-pass timing (expo-video patch)
+    seekPosition.position = 0;
+    return Extractor.RESULT_SEEK;
+  }
+
+  private SshScanResult sshScanFileHead(ExtractorInput input, long inputLength)
+      throws IOException {
+    SshScanResult result = new SshScanResult();
+    long scanLimit = input.getPosition() + SSH_MAX_SCAN_BYTES;
+    boolean inSegment = false;
+    try {
+      for (int elementCount = 0; elementCount < SSH_MAX_SCAN_ELEMENTS; elementCount++) {
+        if (input.getPeekPosition() >= scanLimit) {
+          Log.i(SSH_TAG, "scan: scan budget reached; stopping");
+          break;
+        }
+        SshElementHeader header = sshPeekElementHeader(input);
+        if (header == null) {
+          break;
+        }
+        if (!inSegment) {
+          if (header.id == ID_SEGMENT) {
+            inSegment = true;
+            result.segmentContentPosition = header.contentPosition;
+            Log.i(SSH_TAG, "scan: Segment content starts at "
+                + header.contentPosition + " (size " + header.contentSize + ")");
+          } else if (header.contentSize != C.LENGTH_UNSET) {
+            sshSkipPeek(input, header.contentSize);
+          } else {
+            break;
+          }
+          continue;
+        }
+        if (header.id == ID_SEEK_HEAD) {
+          if (result.primarySeekHeadPosition == C.INDEX_UNSET) {
+            result.primarySeekHeadPosition = header.contentPosition;
+            Log.i(SSH_TAG, "scan: SeekHead at " + header.contentPosition
+                + " (size " + header.contentSize + ")");
+          }
+          if (!sshParseSeekHead(input, header, result, inputLength)) {
+            break;
+          }
+          // Everything the pre-pass can act on is recorded by now; don't burn
+          // peek bandwidth walking Tracks/Attachments after the SeekHead.
+          if (result.directCuesPosition != C.INDEX_UNSET
+              || result.secondarySeekHeadPosition != C.INDEX_UNSET) {
+            break;
+          }
+          continue;
+        }
+        if (header.id == ID_CLUSTER || header.id == ID_CUES) {
+          Log.i(SSH_TAG, "scan: reached "
+              + (header.id == ID_CLUSTER ? "Cluster" : "Cues") + " at "
+              + header.contentPosition + "; metadata region is over");
+          break;
+        }
+        if (header.contentSize == C.LENGTH_UNSET) {
+          break;
+        }
+        sshSkipPeek(input, header.contentSize);
+      }
+    } catch (java.io.EOFException e) {
+      Log.i(SSH_TAG, "scan: end of input during scan");
+    }
+    return result;
+  }
+
+  private boolean sshParseSeekHead(ExtractorInput input, SshElementHeader seekHead,
+      SshScanResult result, long inputLength) throws IOException {
+    if (seekHead.contentSize == C.LENGTH_UNSET) {
+      Log.w(SSH_TAG, "scan: SeekHead with unknown size; skipping");
+      return false;
+    }
+    long end = seekHead.contentPosition + seekHead.contentSize;
+    try {
+      while (input.getPeekPosition() < end) {
+        SshElementHeader child = sshPeekElementHeader(input);
+        if (child == null) {
+          return false;
+        }
+        if (child.id == ID_SEEK) {
+          if (!sshParseSeekEntry(input, child, result, inputLength)) {
+            return false;
+          }
+        } else if (child.contentSize != C.LENGTH_UNSET
+            && input.getPeekPosition() + child.contentSize <= end) {
+          sshSkipPeek(input, child.contentSize);
+        } else {
+          return false;
+        }
+        if (input.getPeekPosition() > end) {
+          return false;
+        }
+      }
+      return true;
+    } catch (java.io.EOFException e) {
+      return false;
+    }
+  }
+
+  private boolean sshParseSeekEntry(ExtractorInput input, SshElementHeader seekElement,
+      SshScanResult result, long inputLength) throws IOException {
+    if (seekElement.contentSize == C.LENGTH_UNSET) {
+      return false;
+    }
+    long end = seekElement.contentPosition + seekElement.contentSize;
+    long targetId = C.INDEX_UNSET;
+    long targetPosition = C.INDEX_UNSET;
+    try {
+      while (input.getPeekPosition() < end) {
+        SshElementHeader child = sshPeekElementHeader(input);
+        if (child == null) {
+          return false;
+        }
+        long payloadEnd = input.getPeekPosition() + child.contentSize;
+        if (child.id == ID_SEEK_ID
+            && child.contentSize >= 0 && child.contentSize <= 8 && payloadEnd <= end) {
+          input.peekFully(sshScratch, 0, (int) child.contentSize);
+          targetId = 0;
+          for (int i = 0; i < (int) child.contentSize; i++) {
+            targetId = (targetId << 8) | (sshScratch[i] & 0xFF);
+          }
+        } else if (child.id == ID_SEEK_POSITION
+            && child.contentSize >= 1 && child.contentSize <= 8 && payloadEnd <= end) {
+          // SeekPosition is an unsigned-int EBML element: its content is a plain
+          // fixed-width big-endian integer (no vint length marker inside the content).
+          input.peekFully(sshScratch, 0, (int) child.contentSize);
+          targetPosition = 0;
+          for (int i = 0; i < (int) child.contentSize; i++) {
+            targetPosition = (targetPosition << 8) | (sshScratch[i] & 0xFF);
+          }
+        } else {
+          if (child.contentSize == C.LENGTH_UNSET || payloadEnd > end) {
+            return false;
+          }
+          sshSkipPeek(input, child.contentSize);
+        }
+        if (input.getPeekPosition() > end) {
+          return false;
+        }
+      }
+    } catch (java.io.EOFException e) {
+      return false;
+    }
+    if (targetId != C.INDEX_UNSET && targetPosition != C.INDEX_UNSET) {
+      sshRecordSeekEntry(targetId, targetPosition, result, inputLength);
+    } else {
+      Log.i(SSH_TAG, "scan: incomplete Seek entry (targetId=" + targetId + ")");
+    }
+    return true;
+  }
+
+  private void sshRecordSeekEntry(long targetId, long relativePosition,
+      SshScanResult result, long inputLength) {
+    if (relativePosition < 0 || result.segmentContentPosition == C.INDEX_UNSET) {
+      Log.w(SSH_TAG, "scan: ignoring invalid Seek entry (targetId=0x"
+          + Long.toHexString(targetId) + ", relative=" + relativePosition + ")");
+      return;
+    }
+    long absolutePosition = result.segmentContentPosition + relativePosition;
+    if (!sshIsPositionInRange(absolutePosition, inputLength)) {
+      Log.w(SSH_TAG, "scan: ignoring out-of-range Seek entry (targetId=0x"
+          + Long.toHexString(targetId) + ", absolute=" + absolutePosition
+          + ", length=" + inputLength + ")");
+      return;
+    }
+    if (targetId == ID_CUES) {
+      if (result.directCuesPosition == C.INDEX_UNSET) {
+        result.directCuesPosition = absolutePosition;
+        Log.i(SSH_TAG, "scan: Seek entry -> Cues at " + absolutePosition
+            + " (relative " + relativePosition + ")");
+      }
+    } else if (targetId == ID_SEEK_HEAD) {
+      if (result.secondarySeekHeadPosition == C.INDEX_UNSET) {
+        result.secondarySeekHeadPosition = absolutePosition;
+        Log.i(SSH_TAG, "scan: Seek entry -> secondary SeekHead at "
+            + absolutePosition + " (relative " + relativePosition + ")");
+      }
+    } else {
+      Log.i(SSH_TAG, "scan: ignoring Seek entry for targetId=0x"
+          + Long.toHexString(targetId));
+    }
+  }
+
+  private SshElementHeader sshPeekElementHeader(ExtractorInput input) throws IOException {
+    try {
+      if (!input.peekFully(sshScratch, 0, 1, /* allowEndOfInput= */ true)) {
+        return null;
+      }
+      int idFirstByte = sshScratch[0] & 0xFF;
+      int idLength = sshIdLength(idFirstByte);
+      if (idLength == -1) {
+        return null;
+      }
+      if (idLength > 1) {
+        input.peekFully(sshScratch, 1, idLength - 1, /* allowEndOfInput= */ false);
+      }
+      long id = idFirstByte;
+      for (int i = 1; i < idLength; i++) {
+        id = (id << 8) | (sshScratch[i] & 0xFF);
+      }
+      if (!input.peekFully(sshScratch, idLength, 1, /* allowEndOfInput= */ true)) {
+        return null;
+      }
+      int sizeFirstByte = sshScratch[idLength] & 0xFF;
+      int vintLength = sshVintLength(sizeFirstByte);
+      if (vintLength == -1) {
+        return null;
+      }
+      if (vintLength > 1) {
+        input.peekFully(sshScratch, idLength + 1, vintLength - 1, /* allowEndOfInput= */ false);
+      }
+      long contentPosition = input.getPeekPosition();
+      long contentSize = sshVintValue(sizeFirstByte, sshScratch, idLength + 1, vintLength);
+      return new SshElementHeader((int) id, contentPosition, contentSize);
+    } catch (java.io.EOFException e) {
+      return null;
+    }
+  }
+
+  private static int sshIdLength(int firstByte) {
+    int length = sshVintLength(firstByte);
+    return (length >= 1 && length <= 4) ? length : -1;
+  }
+
+  private static int sshVintLength(int firstByte) {
+    int length = 1;
+    for (int mask = 0x80; mask != 0; mask >>= 1) {
+      if ((firstByte & mask) != 0) {
+        return length;
+      }
+      length++;
+    }
+    return -1;
+  }
+
+  private static long sshVintValue(int firstByte, byte[] data, int offset, int length) {
+    int mask = 0xFF >> length;
+    long value = firstByte & mask;
+    boolean allValueBitsSet = (firstByte & mask) == mask;
+    for (int i = 1; i < length; i++) {
+      value = (value << 8) | (data[offset + i] & 0xFF);
+      allValueBitsSet &= (data[offset + i] & 0xFF) == 0xFF;
+    }
+    return allValueBitsSet ? C.LENGTH_UNSET : value;
+  }
+
+  private static void sshSkipPeek(ExtractorInput input, long bytes) throws IOException {
+    long remaining = bytes;
+    while (remaining > 0) {
+      int chunk = (int) Math.min(remaining, 64 * 1024);
+      input.advancePeekPosition(chunk);
+      remaining -= chunk;
+    }
+  }
+
+  private static boolean sshIsPositionInRange(long position, long inputLength) {
+    return position >= 0 && (inputLength == C.LENGTH_UNSET || position < inputLength);
+  }
+
+  private static final class SshElementHeader {
+    final int id;
+    final long contentPosition;
+    final long contentSize;
+
+    SshElementHeader(int id, long contentPosition, long contentSize) {
+      this.id = id;
+      this.contentPosition = contentPosition;
+      this.contentSize = contentSize;
+    }
+  }
+
+  private static final class SshScanResult {
+    long segmentContentPosition = C.INDEX_UNSET;
+    long primarySeekHeadPosition = C.INDEX_UNSET;
+    long directCuesPosition = C.INDEX_UNSET;
+    long secondarySeekHeadPosition = C.INDEX_UNSET;
+  }
+
+  // ================ end secondary-SeekHead pre-pass (expo-video patch) ================
+
+}
