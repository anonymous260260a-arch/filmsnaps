+  private fun mergeWithSidecarSubtitles(videoSource: MediaSource): MediaSource {
+    if (sidecarSubtitles.isEmpty()) return videoSource
+    Log.d(
+      SIDECAR_LOG_TAG,
+      "merge: ${sidecarSubtitles.size} sidecar track(s) -> " +
+        sidecarSubtitles.joinToString { "${it.trackId}(${it.mimeType})" },
+    )
+    val dataSourceFactory = DefaultDataSource.Factory(context)
+    val subtitleSources = sidecarSubtitles.map { sidecar ->
+      val configuration = MediaItem.SubtitleConfiguration.Builder(android.net.Uri.parse(sidecar.uri))
+        .setId(sidecar.trackId)
+        .setMimeType(sidecar.mimeType)
+        .setLanguage(sidecar.language)
+        .setLabel(sidecar.label)
+        .setSelectionFlags(C.SELECTION_FLAG_DEFAULT)
+        .build()
+      SingleSampleMediaSource.Factory(dataSourceFactory)
+        .createMediaSource(configuration, C.TIME_UNSET)
+    }
+    return MergingMediaSource(videoSource, *subtitleSources.toTypedArray())
+  }
