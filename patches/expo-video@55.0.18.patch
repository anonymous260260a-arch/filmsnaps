+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package expo.modules.video.utils;
+
+import androidx.media3.common.C;
+import androidx.media3.common.util.ParsableByteArray;
+import androidx.media3.extractor.Extractor;
+import androidx.media3.extractor.ExtractorInput;
+import java.io.IOException;
+
+/**
+ * Utility class that peeks from the input stream in order to determine whether it appears to be
+ * compatible input for this extractor.
+ */
+public final class Sniffer {
+
+  /** The number of bytes to search for a valid header in {@link #sniff(ExtractorInput)}. */
+  private static final int SEARCH_LENGTH = 1024;
+
+  private static final int ID_EBML = 0x1A45DFA3;
+
+  private final ParsableByteArray scratch;
+  private int peekLength;
+
+  public Sniffer() {
+    scratch = new ParsableByteArray(8);
+  }
+
+  /** See {@link Extractor#sniff(ExtractorInput)}. */
+  public boolean sniff(ExtractorInput input) throws IOException {
+    long inputLength = input.getLength();
+    int bytesToSearch =
+        (int)
+            (inputLength == C.LENGTH_UNSET || inputLength > SEARCH_LENGTH
+                ? SEARCH_LENGTH
+                : inputLength);
+    // Find four bytes equal to ID_EBML near the start of the input.
+    input.peekFully(scratch.getData(), 0, 4);
+    long tag = scratch.readUnsignedInt();
+    peekLength = 4;
+    while (tag != ID_EBML) {
+      if (++peekLength == bytesToSearch) {
+        return false;
+      }
+      input.peekFully(scratch.getData(), 0, 1);
+      tag = (tag << 8) & 0xFFFFFF00;
+      tag |= scratch.getData()[0] & 0xFF;
+    }
+
+    // Read the size of the EBML header and make sure it is within the stream.
+    long headerSize = readUint(input);
+    long headerStart = peekLength;
+    if (headerSize == Long.MIN_VALUE
+        || (inputLength != C.LENGTH_UNSET && headerStart + headerSize >= inputLength)) {
+      return false;
+    }
+
+    // Read the payload elements in the EBML header.
+    while (peekLength < headerStart + headerSize) {
+      long id = readUint(input);
+      if (id == Long.MIN_VALUE) {
+        return false;
+      }
+      long size = readUint(input);
+      if (size < 0 || size > Integer.MAX_VALUE) {
+        return false;
+      }
+      if (size != 0) {
+        int sizeInt = (int) size;
+        input.advancePeekPosition(sizeInt);
+        peekLength += sizeInt;
+      }
+    }
+    return peekLength == headerStart + headerSize;
+  }
+
+  /** Peeks a variable-length unsigned EBML integer from the input. */
+  private long readUint(ExtractorInput input) throws IOException {
+    input.peekFully(scratch.getData(), 0, 1);
+    int value = scratch.getData()[0] & 0xFF;
+    if (value == 0) {
+      return Long.MIN_VALUE;
+    }
+    int mask = 0x80;
+    int length = 0;
+    while ((value & mask) == 0) {
+      mask >>= 1;
+      length++;
+    }
+    value &= ~mask;
+    input.peekFully(scratch.getData(), 1, length);
+    for (int i = 0; i < length; i++) {
+      value <<= 8;
+      value += scratch.getData()[i + 1] & 0xFF;
+    }
+    peekLength += length + 1;
+    return value;
+  }
+}
diff --git a/android/src/main/java/expo/modules/video/utils/StreamProbe.kt b/android/src/main/java/expo/modules/video/utils/StreamProbe.kt
new file mode 100644
index 0000000000000000000000000000000000000000..4f18d7d8bde77e0314db8808ce7fa8ae433c6fdd
--- /dev/null
+++ b/android/src/main/java/expo/modules/video/utils/StreamProbe.kt
@@ -0,0 +1,138 @@
+package expo.modules.video.utils
+
+import android.util.Base64
+import android.util.Log
+import expo.modules.kotlin.Promise
+import expo.modules.video.PlayerHttp
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.EventListener
+import okhttp3.Handshake
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.net.Proxy
+import java.util.concurrent.TimeUnit
+
+/**
+ * BEGIN stream-probe (expo-video patch)
+ *
+ * Native ranged GET probe used by stream validation (JS: streamValidator.ts).
+ * Runs on the SAME shared OkHttpClient the player's data sources use
+ * ([PlayerHttp]), so:
+ *  - probe results are maximally predictive of playback (same TLS/header
+ *    construction — the historical JS false-403 class was a fingerprint
+ *    mismatch between the RN fetch stack and the player),
+ *  - a successful probe warms the connection the player reuses,
+ *  - true connect/TLS timings come free via an EventListener.
+ *
+ * Transport only — outcome classification stays in JS. The body read is hard-
+ * capped: a server that ignores the Range header must never make us pull a
+ * whole file. Runs fully async (enqueue); never blocks a module thread.
+ *
+ * Resolves with: statusCode, probeMs, connectMs, tlsMs, bytesRead, contentType,
+ * contentRange, contentLength, acceptRanges, bodyBase64 (first bytes, base64 —
+ * decoded in JS; keeps the bridge surface plain strings/numbers).
+ * END stream-probe (expo-video patch)
+ */
+object StreamProbe {
+  private const val TAG = "StreamProbe"
+  private const val RANGE_HEADER = "bytes=0-8191"
+  private const val MAX_BODY_BYTES = 8192
+
+  fun probe(url: String, headers: Map<String, String>, timeoutMs: Long, promise: Promise) {
+    val startedAt = System.currentTimeMillis()
+
+    val connectStart = arrayOf(0L)
+    val connectEnd = arrayOf(0L)
+    val tlsStart = arrayOf(0L)
+    val tlsEnd = arrayOf(0L)
+
+    val listener = object : EventListener() {
+      override fun connectStart(call: Call, inetSocketAddress: InetSocketAddress, proxy: Proxy) {
+        connectStart[0] = System.currentTimeMillis()
+      }
+
+      override fun connectEnd(
+        call: Call,
+        inetSocketAddress: InetSocketAddress,
+        proxy: Proxy,
+        protocol: Protocol?,
+      ) {
+        connectEnd[0] = System.currentTimeMillis()
+      }
+
+      override fun secureConnectStart(call: Call) {
+        tlsStart[0] = System.currentTimeMillis()
+      }
+
+      override fun secureConnectEnd(call: Call, handshake: Handshake?) {
+        tlsEnd[0] = System.currentTimeMillis()
+      }
+    }
+
+    // newBuilder() shares the singleton's connection pool and dispatcher —
+    // per-call timeouts and instrumentation only.
+    val client: OkHttpClient = PlayerHttp.client.newBuilder()
+      .eventListener(listener)
+      .callTimeout(timeoutMs, TimeUnit.MILLISECONDS)
+      .readTimeout(timeoutMs, TimeUnit.MILLISECONDS)
+      .build()
+
+    val builder = Request.Builder().url(url).header("Range", RANGE_HEADER)
+    for ((key, value) in headers) {
+      try {
+        builder.header(key, value)
+      } catch (e: IllegalArgumentException) {
+        Log.w(TAG, "Dropping illegal probe header: $key")
+      }
+    }
+
+    client.newCall(builder.build()).enqueue(object : Callback {
+      override fun onFailure(call: Call, e: IOException) {
+        Log.i(TAG, "probe failed: ${e.message ?: "network error"}")
+        promise.reject("PROBE_FAILED", e.message ?: "Probe network error", e)
+      }
+
+      override fun onResponse(call: Call, response: Response) {
+        var offset = 0
+        val buffer = ByteArray(MAX_BODY_BYTES)
+        try {
+          response.body?.byteStream()?.use { stream ->
+            while (offset < MAX_BODY_BYTES) {
+              val n = stream.read(buffer, offset, MAX_BODY_BYTES - offset)
+              if (n < 0) break
+              offset += n
+            }
+          }
+        } catch (e: IOException) {
+          // Partial body is fine — classification handles short/empty reads.
+          Log.i(TAG, "probe body read interrupted at $offset bytes: ${e.message}")
+        } finally {
+          response.close()
+        }
+
+        val result = mapOf<String, Any?>(
+          "statusCode" to response.code,
+          "probeMs" to (System.currentTimeMillis() - startedAt).toInt(),
+          "connectMs" to (if (connectEnd[0] > connectStart[0]) (connectEnd[0] - connectStart[0]).toInt() else 0),
+          "tlsMs" to (if (tlsEnd[0] > tlsStart[0]) (tlsEnd[0] - tlsStart[0]).toInt() else 0),
+          "bytesRead" to offset,
+          "contentType" to response.header("Content-Type"),
+          "contentRange" to response.header("Content-Range"),
+          "contentLength" to response.header("Content-Length")?.toLongOrNull(),
+          "acceptRanges" to response.header("Accept-Ranges"),
+          "bodyBase64" to Base64.encodeToString(buffer.copyOf(offset), Base64.NO_WRAP),
+        )
+        Log.i(
+          TAG,
+          "probe ok: status=${response.code} probeMs=${result["probeMs"]} bytes=$offset",
+        )
+        promise.resolve(result)
+      }
+    })
+  }
+}
