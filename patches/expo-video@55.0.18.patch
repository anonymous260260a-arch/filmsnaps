+  fun addSidecarSubtitle(uri: String, mimeType: String, language: String?, label: String?): String? {
+    val trackId = "sidecar_${++sidecarIdCounter}"
+    sidecarSubtitles.add(SidecarSubtitle(trackId, uri, mimeType, language, label))
+    // Only re-prepare when no source switch is in flight and a source is live;
+    // a pending prepare() will pick the new sidecar up on its own.
+    val canReprepareNow = uncommittedSource == null && commitedSource != null
+    Log.d(
+      SIDECAR_LOG_TAG,
+      "add: id=$trackId uri=$uri mime=$mimeType lang=$language label=$label " +
+        "reprepareNow=$canReprepareNow (uncommitted=${uncommittedSource != null}, committed=${commitedSource != null})",
+    )
+    if (canReprepareNow) {
+      val positionMs = player.currentPosition
+      val base = commitedSource?.toMediaSource(context)
+      if (base == null) {
+        Log.w(SIDECAR_LOG_TAG, "add: base toMediaSource() returned null — sidecar $trackId queued, no re-prepare")
