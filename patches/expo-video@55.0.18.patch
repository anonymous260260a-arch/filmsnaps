@@ -0,0 +1,44 @@
+package expo.modules.video.utils
+
+import android.content.Context
+import android.os.Looper
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.Renderer
+import androidx.media3.exoplayer.text.TextOutput
+import androidx.media3.exoplayer.text.TextRenderer
+
+// BEGIN legacy-text-decoding (expo-video patch)
+/**
+ * Enables TextRenderer's legacy subtitle decoding for this player.
+ *
+ * Media3 1.8's TextRenderer defaults legacyDecodingEnabled=false and throws
+ * "Legacy decoding is disabled, can't handle application/x-subrip samples
+ * (expected application/x-media3-cues)" when a stream delivers raw subtitle
+ * samples — note its supportsFormat() still reports such formats as HANDLED,
+ * so the failure only surfaces at render time, after the track is selected.
+ *
+ * Embedded MKV subtitle tracks are unaffected (the vendored extractor parses
+ * them into application/x-media3-cues during extraction), but sidecar
+ * subtitles merged via SingleSampleMediaSource deliver raw samples and need
+ * this opt-in. Cues-with-timeline streams keep using the newer pipeline.
+ */
+@OptIn(UnstableApi::class)
+class LegacyTextRenderersFactory(context: Context) : DefaultRenderersFactory(context) {
+  override fun buildTextRenderers(
+    context: Context,
+    output: TextOutput,
+    looper: Looper,
+    extensionRendererMode: Int,
+    out: ArrayList<Renderer>,
+  ) {
