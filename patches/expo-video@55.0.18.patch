+// BEGIN shared-OkHttp-client (expo-video patch)
+/**
+ * One process-wide OkHttp client shared by every player data source and the
+ * stream probe (StreamProbe). Upstream builds a fresh client per VideoSource —
+ * a new connection pool per play — so every source switch and fallback paid a
+ * full TCP+TLS handshake and nothing could be pre-warmed. Probe + player now
+ * share this pool and this TLS/header stack, so probe verdicts match playback.
+ */
+// BEGIN traffic-instrumentation (expo-video patch)
+private const val TRAFFIC_TAG = "PlayerHttp"
+private const val TRAFFIC_CHUNK_BYTES = 2L * 1024 * 1024
+
+/**
+ * Counts bytes delivered through a response body and logs the rate every
+ * ~2MB and on close, tagged with the requested Range offset. Distinguishes a
+ * slow source (low KB/s while buffers run dry) from a slow extract/read loop
+ * (healthy KB/s while buffers still run dry).
+ */
+private class CountingBody(
+  private val delegate: ResponseBody,
+  private val host: String,
+  private val range: String,
+) : ResponseBody() {
+  private val bytesRead = AtomicLong()
+  private var chunkStartBytes = 0L
+  private var chunkStartNs = System.nanoTime()
+  private val totalStartNs = chunkStartNs
+
+  override fun contentType(): okhttp3.MediaType? = delegate.contentType()
+  override fun contentLength(): Long = delegate.contentLength()
+
+  override fun source(): BufferedSource {
+    return object : ForwardingSource(delegate.source()) {
+      override fun read(sink: Buffer, byteCount: Long): Long {
+        val read = super.read(sink, byteCount)
+        if (read > 0) {
+          val total = bytesRead.addAndGet(read)
+          if (total - chunkStartBytes >= TRAFFIC_CHUNK_BYTES) {
+            logChunk(total)
+          }
+        }
+        return read
+      }
+
+      override fun close() {
+        try {
+          super.close()
+        } finally {
+          val total = bytesRead.get()
+          if (total > 0) {
+            val elapsedMs = (System.nanoTime() - totalStartNs) / 1_000_000L
+            Log.i(
+              TRAFFIC_TAG,
+              "traffic END host=$host range=$range " +
+                "${total / 1024}KB in ${elapsedMs}ms " +
+                "(${(total / 1024) * 1000 / maxOf(1L, elapsedMs)}KB/s)",
+            )
+          }
+        }
+      }
+    }.buffer()
+  }
+
+  private fun logChunk(total: Long) {
+    val nowNs = System.nanoTime()
+    val deltaBytes = total - chunkStartBytes
+    val deltaMs = (nowNs - chunkStartNs) / 1_000_000L
+    Log.i(
+      TRAFFIC_TAG,
+      "traffic host=$host range=$range " +
+        "+${deltaBytes / 1024}KB in ${deltaMs}ms " +
+        "(${(deltaBytes / 1024) * 1000 / maxOf(1L, deltaMs)}KB/s) " +
+        "total=${total / 1024}KB",
+    )
+    chunkStartBytes = total
+    chunkStartNs = nowNs
+  }
+}
+
+private fun trafficInterceptor(chain: Interceptor.Chain): Response {
+  val request = chain.request()
+  val response = chain.proceed(request)
+  val body = response.body ?: return response
+  return response.newBuilder().body(
+    CountingBody(
+      delegate = body,
+      host = request.url.host,
+      range = request.header("Range") ?: "none",
+    )
+  ).build()
+}
+// END traffic-instrumentation (expo-video patch)
+
+object PlayerHttp {
+  // BEGIN player-tuning (expo-video patch)
+  /** JS-tunable timeouts (ms) for the shared player/probe HTTP client. Defaults = stock OkHttp. */
+  const val DEFAULT_HTTP_CONNECT_TIMEOUT_MS = 10_000L
+  const val DEFAULT_HTTP_READ_TIMEOUT_MS = 10_000L
+
+  @Volatile
+  var httpConnectTimeoutMs: Long = DEFAULT_HTTP_CONNECT_TIMEOUT_MS
+    private set
