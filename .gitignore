# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/

# testing
coverage/

# next.js
.next/
out/

# production
build
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.dev.vars

# vercel
.vercel

# desktop app builds
apps/desktop/dist/
apps/desktop/release/

# opennext / cloudflare build output
.open-next/

# custom scripts (repo-root only — anchored so it does NOT swallow nested
# scripts/ dirs like packages/shared/scripts (fix-dist-imports.mjs) or
# apps/desktop/scripts, which EAS/Netlify archive walkers would drop)
/scripts/

# IDE / AI
.bolt/
.claude/
.agents/
.qwen/

# AI audit scratch output (file dumps, phase notes — not app source)
.audit/

# agent-skill lockfile (runtime-generated by installed skills)
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# turbo
.turbo/

# expo
.expo/

# mobile builds
apps/mobile/android/
apps/mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# config signing — Ed25519 private key NEVER committed; public key is
.keys/*.key
!.keys/filmsnaps-ed25519.pub

# mobile build artifacts
*.log
build_commands.txt

# pnpm — lockfile must be committed for reproducible builds
# pnpm-lock.yaml

# planning / design docs (not part of the app source)
apps/feedback/.wrangler

# local signing/response artifacts (never push)
_rp.json
_rs.sig
expertResponseFiles_TEMP/
